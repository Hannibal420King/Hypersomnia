{
  "schemaVersion": "1.0",
  "revision": 1,
  "requiredScopes": [
    "identity.basic",
    "play.write",
    "events.write",
    "gamification.read",
    "rewards.read"
  ],
  "optionalScopes": [],
  "events": [
    {
      "key": "hypersomnia.gameplay.entered",
      "version": 1,
      "displayName": "Gameplay entered",
      "description": "The player entered an active Hypersomnia gameplay state.",
      "valueType": "COUNTER",
      "aggregation": "SUM",
      "source": "GAME_SESSION",
      "attributes": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "key": "hypersomnia.session.joined",
      "version": 1,
      "displayName": "Session joined",
      "description": "The browser entered a confirmed Hypersomnia game-session route.",
      "valueType": "COUNTER",
      "aggregation": "SUM",
      "source": "GAME_SESSION",
      "attributes": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "notificationTemplates": [],
  "presenceStates": [],
  "invitePaths": [
    "/"
  ],
  "deployment": {
    "schemaVersion": "1.0",
    "gateway": {
      "service": "web",
      "port": "http"
    },
    "services": [
      {
        "name": "web",
        "image": {
          "source": "APP"
        },
        "environment": {
          "PORT": "8080"
        },
        "vortexEnvironment": true,
        "ports": [
          {
            "name": "http",
            "containerPort": 8080,
            "protocol": "TCP",
            "exposure": "INTERNAL"
          }
        ],
        "healthCheck": {
          "protocol": "HTTP",
          "port": "http",
          "path": "/healthz",
          "initialDelaySeconds": 5,
          "intervalSeconds": 10,
          "timeoutSeconds": 3,
          "retries": 12
        },
        "resources": {
          "cpuCores": 0.5,
          "memoryMb": 768,
          "pidsLimit": 128
        },
        "mounts": [],
        "dependsOn": [],
        "readOnlyRootfs": true,
        "stopGraceSeconds": 10
      },
      {
        "name": "server",
        "image": {
          "source": "OCI",
          "reference": "ghcr.io/teamhypersomnia/hypersomnia-server@sha256:2b6fef2c3dded7b1d206ad17b050dfa490267a4dbe6581813a7d023694f611b5"
        },
        "environment": {},
        "ports": [
          {
            "name": "web-rtc",
            "containerPort": 9000,
            "protocol": "UDP",
            "exposure": "HOST",
            "hostPort": 9000
          }
        ],
        "healthCheck": {
          "protocol": "PROCESS",
          "initialDelaySeconds": 10,
          "intervalSeconds": 10,
          "timeoutSeconds": 3,
          "retries": 12
        },
        "resources": {
          "cpuCores": 2,
          "memoryMb": 2048,
          "pidsLimit": 512
        },
        "mounts": [
          {
            "volume": "server-data",
            "target": "/home/hypersomniac/.config/Hypersomnia/user",
            "readOnly": false
          }
        ],
        "dependsOn": [],
        "readOnlyRootfs": false,
        "stopGraceSeconds": 30
      }
    ],
    "volumes": [
      {
        "name": "server-data",
        "kind": "PERSISTENT"
      }
    ]
  }
}
